{
  "name": "dsh-mnemon-source-global-todo",
  "version": "0.1.2",
  "description": "Expose dsh-global-todo's open items to dsh-mnemon as a read-only memory Source.",
  "type": "module",
  "license": "MIT",
  "author": "LUgABeEEE",
  "homepage": "https://github.com/LUgABeEEE/dsh-mnemon-source-global-todo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUgABeEEE/dsh-mnemon-source-global-todo.git"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "dsh-mnemon": ">=0.5.34"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mnemon",
    "memory",
    "todo",
    "source"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
